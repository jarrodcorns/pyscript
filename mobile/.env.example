# RevenueCat (required for production store builds)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=full_program

# Local development only — bypasses paywall in __DEV__
EXPO_PUBLIC_ENABLE_DEV_UNLOCK=false

# Optional Supabase profile sync
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
